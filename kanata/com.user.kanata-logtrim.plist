<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.kanata-logtrim</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/allenmyers/.config/kanata/trim-kanata-logs.sh</string>
	</array>
	<!-- Hourly, plus once at load so a log that ballooned while this was
	     uninstalled gets cut down immediately rather than an hour later. -->
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/opt/homebrew/var/log/kanata-logtrim.log</string>
	<key>StandardOutPath</key>
	<string>/opt/homebrew/var/log/kanata-logtrim.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/allenmyers</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
